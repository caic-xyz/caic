{
  "name": "caic-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check:pre-commit": "scripts/check-staged.sh",
    "dev": "vite",
    "build": "vite build",
    "benchmark": "tsx scripts/bench.ts 'frontend/src/**/*.bench.ts'",
    "postbuild": "./scripts/precompress_dist.py --dist backend/frontend/dist --delete-originals --encodings br",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage tsx --test --conditions=browser --test-force-exit --test-reporter=./scripts/quiet-test-reporter.mjs --import ./frontend/tests/setup-dom.ts 'frontend/src/**/*.test.ts' 'frontend/src/**/*.test.tsx'",
    "test:watch": "pnpm --silent test -- --watch",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage tsx --test --conditions=browser --test-force-exit --experimental-test-coverage --test-reporter=./scripts/quiet-test-reporter.mjs --import ./frontend/tests/setup-dom.ts 'frontend/src/**/*.test.ts' 'frontend/src/**/*.test.tsx'",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/e2e.tsbuildinfo -p e2e/tsconfig.json",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content .",
    "lint:fix": "eslint . --fix",
    "lint:style": "pnpm --silent lint:style:files -- \"frontend/src/**/*.css\"",
    "lint:style:files": "stylelint",
    "lint:style:fix": "pnpm exec stylelint --fix \"frontend/src/**/*.css\"",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check --log-level warn --cache --cache-location node_modules/.cache/prettier/.prettier-cache --cache-strategy content .",
    "hooks:install": "scripts/install-git-hooks.sh",
    "prepare": "pnpm --silent hooks:install"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.47.2",
    "@novnc/novnc": "1.7.0",
    "@observablehq/plot": "0.6.17",
    "@solidjs/router": "1.0.0",
    "marked": "18.0.12",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "7.20.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.5.1",
    "@vitest/expect": "5.0.0",
    "@vitest/spy": "5.0.0",
    "babel-preset-solid": "1.9.15",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-solid": "0.18.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "tinybench": "^6.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vite-solid-svg": "0.0.8"
  }
}
