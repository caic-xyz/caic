{
  "name": "caic-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check:pre-commit": "scripts/check-staged.sh",
    "dev": "vite",
    "build": "vite build",
    "benchmark": "vitest bench --run --maxWorkers=1 --no-file-parallelism",
    "postbuild": "./scripts/compress_dist.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "hooks:install": "scripts/install-git-hooks.sh",
    "prepare": "pnpm hooks:install"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.47.0",
    "@novnc/novnc": "1.7.0",
    "@observablehq/plot": "^0.6.17",
    "@solidjs/router": "^1.0.0",
    "marked": "^18.0.11",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.16.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vite-solid-svg": "^0.0.8",
    "vitest": "^4.1.11"
  }
}
