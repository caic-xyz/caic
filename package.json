{
  "name": "caic-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others \"node scripts/css_module_types.mjs --source-path frontend/src --watch\" \"vite\"",
    "build": "node scripts/css_module_types.mjs --source-path frontend/src && vite build",
    "postbuild": "uv run --locked python scripts/precompress_dist.py --dist backend/frontend/dist --delete-originals --encodings br",
    "preview": "vite preview"
  },
  "dependencies": {
    "@maruel/gomode": "git+https://github.com/maruel/gomode.git#949e2973d8386a2d9b20a043188055ff17912519",
    "@material-symbols/svg-400": "0.47.4",
    "@novnc/novnc": "1.7.0",
    "@observablehq/plot": "0.6.17",
    "@solidjs/router": "1.0.0",
    "dompurify": "3.4.16",
    "marked": "18.0.13",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.4.299",
    "pele": "1.6.0",
    "saxes": "6.0.0",
    "solid-js": "1.9.15",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "7.20.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "@vitest/expect": "5.0.1",
    "@vitest/spy": "5.0.1",
    "babel-preset-solid": "1.9.15",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-solid": "0.18.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "tinybench": "^6.2.0",
    "tsx": "4.23.15",
    "typed-css-modules": "0.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vite-solid-svg": "0.1.1"
  }
}
