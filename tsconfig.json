{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@testing-library/jest-dom", "vite-solid-svg", "vitest/globals"],
    "paths": {
      "@sdk/*": ["./sdk/caic/ts/v1/*"],
      "@voicegateway-sdk/*": ["./sdk/voicegateway/ts/v1/*"],
      "@mcp-sdk/*": ["./sdk/mcp/ts/v1/*"]
    }
  },
  "include": ["frontend/src", "sdk/caic", "sdk/voicegateway", "sdk/mcp"]
}
