# caic systemd user service using the login-unlocked desktop SSH agent.
# Install: mkdir -p ~/.config/systemd/user && cp contrib/caic.service ~/.config/systemd/user/
#          mkdir -p ~/.config/caic && cp contrib/config.toml ~/.config/caic/config.toml
#          Edit ~/.config/caic/config.toml (see contrib/config.toml for documentation).
# Enable:  systemctl --user daemon-reload && systemctl --user enable --now caic
# Logs:    journalctl --user -u caic -f

[Unit]
Description=Coding Agents in Containers
Documentation=https://github.com/caic-xyz/caic
After=network-online.target podman.socket graphical-session-pre.target gnome-keyring-daemon.service
# Start Podman's packaged socket when available without requiring it for Docker-only setups.
Wants=network-online.target podman.socket gnome-keyring-daemon.service

[Service]
Type=simple
ExecStart=%h/.local/bin/caic
WorkingDirectory=%h
# The Podman CLI becomes a remote client; the separate podman.service owns containers.
Environment=CONTAINER_HOST=unix://%t/podman/podman.sock
# Environment overrides belong in ~/.config/systemd/user/caic.env.
# For example, use it to add ~/.local/bin to PATH.
EnvironmentFile=%h/.config/systemd/user/caic.env
# Use the desktop agent independently of inherited shell environments.
Environment=SSH_AUTH_SOCK=%t/keyring/ssh
# Retry via Restart=always until the desktop SSH socket is available.
ExecStartPre=/usr/bin/test -S %t/keyring/ssh
Restart=always
RestartSec=1s

# --- Resource Limits ---
CPUQuota=800%
MemoryMax=4G
MemoryHigh=3G
OOMScoreAdjust=100

# --- Security Hardening ---

# Filesystem isolation
# Caic stores state and manages repositories under the configurable home-rooted workspace.
ProtectSystem=strict
ReadWritePaths=%h
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid

# Capability restrictions
NoNewPrivileges=true
AmbientCapabilities=

# Network restrictions (allow only IPv4/IPv6/Unix sockets)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filtering
SystemCallArchitectures=native
# Podman's remote client requires system calls outside @system-service.
# SystemCallFilter=@system-service
# SystemCallFilter=~@privileged @resources @obsolete

# Memory/execution restrictions
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Misc
UMask=0077
KeyringMode=private
RemoveIPC=true

[Install]
WantedBy=graphical-session.target
