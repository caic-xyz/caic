# caic systemd user service.
# Install: mkdir -p ~/.config/systemd/user && cp contrib/caic.service ~/.config/systemd/user/
#          mkdir -p ~/.config/caic && cp contrib/config.toml ~/.config/caic/config.toml
#          Edit ~/.config/caic/config.toml (see contrib/config.toml for documentation).
# Enable:  systemctl --user daemon-reload && systemctl --user enable --now caic
# Logs:    journalctl --user -u caic -f

[Unit]
Description=Coding Agents in Containers
Documentation=https://github.com/caic-xyz/caic
After=network-online.target podman.socket graphical-session-pre.target
# Start Podman's packaged socket when available without requiring it for Docker-only setups.
Wants=network-online.target podman.socket
# Let the packaged OpenSSH socket publish SSH_AUTH_SOCK before caic starts.
Wants=ssh-agent.socket
After=ssh-agent.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/caic
WorkingDirectory=%h
# The Podman CLI becomes a remote client; the separate podman.service owns containers.
Environment=CONTAINER_HOST=unix://%t/podman/podman.sock
# With core.shell_env=false, environment overrides belong in this optional file.
# Otherwise, shell exports replace inherited values such as PATH.
EnvironmentFile=-%h/.config/systemd/user/caic.env
# caic imports PATH and SSH_AUTH_SOCK from the user's shell by default.
# Set core.shell_env=false to use only the service environment.
# On Debian and Ubuntu releases that ship this socket path, uncomment if
# SSH_AUTH_SOCK is missing from the service environment.
# Environment=SSH_AUTH_SOCK=%t/openssh_agent
Restart=always
RestartSec=1s

# --- Resource Limits ---
CPUQuota=800%
MemoryMax=4G
MemoryHigh=3G
OOMScoreAdjust=100

# --- Security Hardening ---

# Keep filesystem namespacing off in this user unit. It implicitly enables UID
# mapping, which makes OpenSSH reject root-owned host configuration fragments.
# Process visibility
ProtectProc=invisible
ProcSubset=pid

# Capability restrictions
NoNewPrivileges=true
AmbientCapabilities=

# Network restrictions (allow only IPv4/IPv6/Unix sockets)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filtering
SystemCallArchitectures=native
# Podman's remote client requires system calls outside @system-service.
# SystemCallFilter=@system-service
# SystemCallFilter=~@privileged @resources @obsolete

# Memory/execution restrictions
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Misc
UMask=0077
KeyringMode=private
RemoveIPC=true

[Install]
WantedBy=default.target
