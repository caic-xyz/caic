<?xml version="1.0" encoding="UTF-8"?>
<!-- caic macOS launchd user agent -->
<!-- Install: cp contrib/com.caic.caic.plist ~/Library/LaunchAgents/ -->
<!--          mkdir -p ~/.config/caic && cp contrib/config.toml ~/.config/caic/config.toml -->
<!--          Edit ~/.config/caic/config.toml (see contrib/config.toml for documentation). -->
<!-- Enable:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.caic.caic.plist -->
<!-- Disable: launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.caic.caic.plist -->
<!-- Logs:    tail -f /tmp/caic.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.caic.caic</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/CHANGEME/.local/bin/caic</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/caic.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/caic.log</string>

	<key>ProcessType</key>
	<string>Background</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
</dict>
</plist>
